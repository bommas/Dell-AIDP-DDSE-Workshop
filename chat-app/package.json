{
  "name": "chat-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n proxy,vite -c cyan,magenta \"npm run proxy\" \"npm run vite\"",
    "proxy": "node server.mjs",
    "vite": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "concurrently -k -n proxy,preview -c cyan,magenta \"npm run proxy\" \"vite preview --port 5173\""
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
