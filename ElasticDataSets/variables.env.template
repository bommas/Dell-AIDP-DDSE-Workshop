# Elastic Cloud Configuration (Serverless or Elastic Cloud Hosted)
# Copy to variables.env and replace with your values:
#   cp variables.env.template variables.env

export ES_URL="https://your-deployment.es.us-east-1.aws.found.io:443"
export ES_API_KEY="your-base64-encoded-elastic-cloud-api-key"
# Optional: Kibana URL for auto-creating data views after ingest.
# If unset, derived from ES_URL by replacing ".es." with ".kb."
# export KIBANA_URL="https://your-deployment.kb.us-east-1.aws.found.io:443"

# Elastic Cloud inference endpoints
# Embeddings: Jina on Elastic Inference Service (EIS) — available by default, no Jina API key
# https://www.elastic.co/docs/explore-analyze/elastic-inference/eis
# https://www.elastic.co/docs/explore-analyze/machine-learning/nlp/ml-nlp-jina
export ELSER_INFERENCE_ID=".elser-2-elasticsearch"
export EMBEDDING_INFERENCE_ID="jina-embeddings-v3"
export JINA_MODEL_ID="jina-embeddings-v3"
# Optional: keep E5 available if you switch back
export E5_INFERENCE_ID=".multilingual-e5-small-elasticsearch"

# Bulk Ingestion Configuration
export INGEST_BULK_SIZE=200
export INGEST_THREAD_COUNT=4
export INGEST_QUEUE_SIZE=1000
export ES_REQUEST_TIMEOUT=300
